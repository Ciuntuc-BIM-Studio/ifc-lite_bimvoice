{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lapin",
  "identifier": "app.lapin.desktop",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --filter @ifc-lite/viewer dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": {
      "script": "pnpm --filter @ifc-lite/viewer build",
      "cwd": "../.."
    },
    "frontendDist": "../../viewer/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lapin",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "lapin"
        ],
        "name": "Lapin project",
        "description": "Lapin project",
        "role": "Editor",
        "mimeType": "application/zip"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
